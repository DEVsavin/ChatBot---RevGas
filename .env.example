REVGAS_API_KEY=coloque-sua-chave-aqui
REVGAS_API_URL=https://api.revgas.com/v1
# Venda real (só com --venda-real): o cliente de demonstração usado em toda venda
# enquanto a busca de clientes estiver bloqueada para a chave.
REVGAS_CLIENTE_DEMO=coloque-o-numero-do-cliente
# IA (Gemini, cota grátis do Google AI Studio). Só para os clientes fictícios.
GEMINI_API_KEY=coloque-sua-chave-aqui
# WhatsApp (Cloud API da Meta, número de teste). Passo a passo: docs/whatsapp-passo-a-passo.md
WHATSAPP_TOKEN=coloque-o-token-aqui
WHATSAPP_PHONE_NUMBER_ID=coloque-o-id-do-numero-aqui
WHATSAPP_BUSINESS_ACCOUNT_ID=coloque-o-id-da-conta-aqui
WHATSAPP_APP_SECRET=coloque-a-chave-secreta-do-app-aqui
# Gere com: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
WHATSAPP_VERIFY_TOKEN=gere-um-valor-aleatorio
# Até 5 números da equipe (com DDD), separados por vírgula. Só eles usam a IA.
WHATSAPP_NUMEROS_EQUIPE=86900000000
# Só o domínio fixo do ngrok, sem https://
WHATSAPP_DOMINIO=seu-dominio.ngrok-free.app
