REVGAS_API_KEY=coloque-sua-chave-aqui
REVGAS_API_URL=https://api.revgas.com/v1
# Venda real (só com --venda-real): o cliente de demonstração usado em toda venda
# enquanto a busca de clientes estiver bloqueada para a chave.
REVGAS_CLIENTE_DEMO=coloque-o-numero-do-cliente
# WhatsApp: até 5 números da equipe (com DDD), separados por vírgula (com WAHA_ATENDER=equipe).
WHATSAPP_NUMEROS_EQUIPE=86900000000
# WhatsApp pelo chip (WAHA, no Docker desta máquina). Passo a passo no README.
WAHA_URL=http://127.0.0.1:3000
WAHA_SESSAO=default
# Gere cada uma com: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
WAHA_API_KEY=gere-um-valor-aleatorio
WAHA_HMAC_KEY=gere-um-valor-aleatorio-com-32-ou-mais-caracteres
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=gere-um-valor-aleatorio
# equipe (padrão: só WHATSAPP_NUMEROS_EQUIPE) ou todos
WAHA_ATENDER=equipe
